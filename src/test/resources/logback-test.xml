<configuration>
    <!-- 1. Убираем спам от Apache HttpClient  -->
    <logger name="org.apache.http" level="WARN"/>
    <logger name="org.apache.hc" level="WARN"/>

    <!-- 2. Убираем спам от Selenium -->
    <logger name="org.openqa.selenium" level="WARN"/>

    <!-- 3. Убираем спам от Spring  -->
    <logger name="org.springframework" level="WARN"/>

    <!-- 4. Убираем спам от Maven -->
    <logger name="org.apache.maven" level="WARN"/>

    <!-- 5. Корневой уровень: показываем только INFO и выше -->
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

    <!-- 6. Настройка вывода в консоль (с датой, потоком и уровнем) -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
</configuration>
